import random
import pgzrun
import time

WIDTH=500
HEIGHT=500
TITLE='Human Life Cycle'

prenatal=Actor('prenatal')
infant=Actor('infancy')
child=Actor('child')
adolescence=Actor('adolesence')
adult=Actor('adult')
elderly=Actor('elderly')



prenatal.x=random.randint(50,WIDTH-50)
prenatal.y=random.randint(90,HEIGHT-50)
infant.x=random.randint(50,WIDTH-50)
infant.y=random.randint(90,HEIGHT-50)
child.x=random.randint(50,WIDTH-50)
child.y=random.randint(90,HEIGHT-50)
adolescence.x=random.randint(50,WIDTH-50)
adolescence.y=random.randint(90,HEIGHT-50)
adult.x=random.randint(50,WIDTH-50)
adult.y=random.randint(90,HEIGHT-50)
elderly.x=random.randint(50,WIDTH-50)
elderly.y=random.randint(90,HEIGHT-50)

actors=[prenatal,infant,child,adolescence,adult,elderly]
curact=0
num=6
lines=[]

starttime=time.time()
timepassed=0


def draw():
    screen.blit('human background',(0,0))
    prenatal.draw()
    infant.draw()
    child.draw()
    adolescence.draw()
    adult.draw()
    elderly.draw()
    for line in lines:
        screen.draw.line(line[0],line[1],'red')
    screen.draw.text(f'Timer:{timepassed}',(10,10),fontsize=50,color='red')

def on_mouse_down(pos):
    global curact,actors,lines
    if curact<num:
        if actors[curact].collidepoint(pos):
            if curact!=0:
                curpos=actors[curact].pos
                prevpos=actors[curact-1].pos
                lines.append([curpos,prevpos])
            curact=curact+1 
        else:
            lines=[]
            curact=0       
    print(lines)
def update():
    global timepassed
    if curact!=num:
        timepassed=round(time.time()-starttime,1)
pgzrun.go()